{
  "name": "assessment-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24.12.0 <25",
    "pnpm": ">=10.34.6 <11"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @assessment/frontend --filter @assessment/admin --filter @assessment/backend dev",
    "dev:frontend": "pnpm --filter @assessment/frontend dev",
    "dev:admin": "pnpm --filter @assessment/admin dev",
    "dev:backend": "pnpm --filter @assessment/backend dev",
    "build": "pnpm db:generate && pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.test.json",
    "lint": "pnpm -r lint",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "contracts:build": "node scripts/build-openapi.mjs",
    "contracts:generate": "pnpm contracts:build && openapi-typescript contracts/openapi.json -o contracts/generated/api.d.ts",
    "contracts:lint": "redocly lint contracts/openapi.json",
    "config:check": "node scripts/validate-scaffold.mjs",
    "docs:structure": "node scripts/write-structure.mjs",
    "test": "node --test test/*.test.mjs",
    "test:backend": "pnpm --filter @assessment/backend test",
    "test:frontend": "pnpm --filter @assessment/frontend test",
    "test:e2e": "pnpm --filter @assessment/backend build && pnpm --filter @assessment/frontend build && playwright test",
    "db:migrate": "pnpm --filter @assessment/backend db:migrate",
    "db:seed": "pnpm --filter @assessment/backend db:seed",
    "dev:student": "pnpm --filter @assessment/backend dev:student",
    "scaffold:smoke": "pnpm --filter @assessment/backend build && node scripts/check-api-scaffold.mjs",
    "db:validate": "pnpm --filter @assessment/backend db:validate",
    "db:generate": "pnpm --filter @assessment/backend db:generate",
    "validate": "pnpm config:check && pnpm contracts:lint && pnpm db:validate && pnpm db:generate && pnpm typecheck && pnpm lint && pnpm test",
    "infra:config": "docker compose --env-file .env config --quiet",
    "infra:up": "docker compose --env-file .env up -d --wait",
    "infra:stop": "docker compose --env-file .env stop"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@playwright/test": "1.64.0",
    "typescript": "5.9.3",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.71.1",
    "globals": "16.5.0",
    "prettier": "3.9.10",
    "openapi-typescript": "7.13.0",
    "@redocly/cli": "2.62.1",
    "yaml": "2.9.1"
  }
}
