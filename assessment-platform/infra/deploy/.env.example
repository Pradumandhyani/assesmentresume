# Paths point to workload-provisioned private files outside source control.
# Replace EVERY digest with reviewed built/scanned images. check-deployment rejects placeholders.
FRONTEND_IMAGE=registry.example.invalid/assessment/frontend@sha256:REPLACE
ADMIN_IMAGE=registry.example.invalid/assessment/admin@sha256:REPLACE
API_IMAGE=registry.example.invalid/assessment/api@sha256:REPLACE
MAINTENANCE_IMAGE=registry.example.invalid/assessment/maintenance@sha256:REPLACE
JUDGE_IMAGE=registry.example.invalid/assessment/judge@sha256:REPLACE
MIGRATION_IMAGE=registry.example.invalid/assessment/migrate@sha256:REPLACE
CADDY_IMAGE=caddy@sha256:REPLACE
STUDENT_HOST=students.example.invalid
ADMIN_HOST=admin.example.invalid
ACME_EMAIL=operations@example.invalid
API_ENV_FILE=/etc/assessment/api.env
ADMIN_API_ENV_FILE=/etc/assessment/admin-api.env
MAINTENANCE_ENV_FILE=/etc/assessment/maintenance.env
JUDGE_ENV_FILE=/etc/assessment/judge.env
MIGRATION_ENV_FILE=/etc/assessment/migration.env
ADMIN_QUESTION_KEYRING_FILE=/etc/assessment/secrets/question-keyring.json
JUDGE_SECRET_DIRECTORY=/etc/assessment/judge-secrets
TOOLCHAIN_CATALOG_FILE=/etc/assessment/toolchains.json
