NODE_ENV=production
PORT=4000
LOG_LEVEL=info
# Shared restricted auth/session pool, separate privileged question/admin pool.
DATABASE_URL=postgresql://assessment_api:REPLACE_WITH_PRIVATE_PASSWORD@private-postgres.example.invalid/assessment?sslmode=verify-full
DATABASE_POOL_MAX=5
ADMIN_DATABASE_URL=postgresql://assessment_admin:REPLACE_WITH_PRIVATE_PASSWORD@private-postgres.example.invalid/assessment?sslmode=verify-full
ADMIN_DATABASE_POOL_MAX=5
REDIS_QUEUE_URL=rediss://assessment_admin:REPLACE_WITH_PRIVATE_PASSWORD@private-redis.example.invalid:6379/0
REDIS_SESSION_URL=rediss://assessment_admin:REPLACE_WITH_PRIVATE_PASSWORD@private-redis.example.invalid:6379/1
APP_ORIGINS=https://admin.example.invalid
ADMIN_ORIGINS=https://admin.example.invalid
SESSION_COOKIE_NAME=__Host-assessment_session
SESSION_SECURE=true
CSRF_SIGNING_KEY=REPLACE_WITH_SHARED_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
TRUST_PROXY_HOPS=1
JUDGE_QUEUE_PREFIX=assessment-production
PUBLIC_TESTCASE_KMS_KEY_ID=REPLACE_WITH_ACTIVE_PUBLIC_KEY_IDENTIFIER
EXECUTION_ENABLED=false
QUESTION_KEYRING_FILE=/run/assessment-secrets/question-keyring.json
SANDBOX_TOOLCHAIN_CATALOG=/etc/assessment/toolchains.json
