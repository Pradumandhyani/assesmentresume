NODE_ENV=production
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgresql://assessment_api:REPLACE_WITH_PRIVATE_PASSWORD@private-postgres.example.invalid/assessment?sslmode=verify-full
DATABASE_POOL_MAX=20
REDIS_QUEUE_URL=rediss://assessment_api:REPLACE_WITH_PRIVATE_PASSWORD@private-redis.example.invalid:6379/0
REDIS_SESSION_URL=rediss://assessment_api:REPLACE_WITH_PRIVATE_PASSWORD@private-redis.example.invalid:6379/1
APP_ORIGINS=https://students.example.invalid
SESSION_COOKIE_NAME=__Host-assessment_session
SESSION_SECURE=true
SESSION_TTL_SECONDS=43200
SESSION_REMEMBER_TTL_SECONDS=604800
CSRF_SIGNING_KEY=REPLACE_WITH_SHARED_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
TRUST_PROXY_HOPS=1
LOGIN_ACCOUNT_LIMIT=10
LOGIN_IP_LIMIT=1000
LOGIN_WINDOW_SECONDS=900
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
JUDGE_QUEUE_PREFIX=assessment-production
PUBLIC_TESTCASE_KMS_KEY_ID=REPLACE_WITH_ACTIVE_PUBLIC_KEY_IDENTIFIER
EXECUTION_ENABLED=false
EXECUTION_MAX_PENDING_PUBLIC=1500
EXECUTION_MAX_PENDING_HIDDEN=1500
# Deliberately no ADMIN_DATABASE_URL, ADMIN_ORIGINS, testcase keyring or broker secrets.
