[Unit]
Description=Assessment gVisor mTLS sandbox broker
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=assessment-sandbox
Group=assessment-sandbox
SupplementaryGroups=docker
WorkingDirectory=/opt/assessment-platform/backend
EnvironmentFile=/opt/assessment-platform/backend/.env.sandbox.local
ExecStart=/usr/bin/node dist/workers/sandbox/broker.js
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/run/docker.sock
UMask=0077
TimeoutStopSec=40

[Install]
WantedBy=multi-user.target
