[Unit]
Description=Remove expired assessment sandboxes independently of broker availability
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=assessment-sandbox
Group=assessment-sandbox
SupplementaryGroups=docker
WorkingDirectory=/opt/assessment-platform/backend
EnvironmentFile=/opt/assessment-platform/backend/.env.sandbox.local
ExecStart=/usr/bin/node dist/workers/sandbox/reaper.js
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/run/docker.sock
UMask=0077
