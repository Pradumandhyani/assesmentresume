NODE_ENV=development
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgresql://assessment_dev:replace-with-local-development-password@127.0.0.1:5432/assessment_dev?schema=public
DATABASE_POOL_MAX=20
REDIS_QUEUE_URL=redis://127.0.0.1:6379/0
REDIS_SESSION_URL=redis://127.0.0.1:6379/1
APP_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://localhost:8081
SESSION_COOKIE_NAME=assessment_session_dev
SESSION_SECURE=false
SESSION_TTL_SECONDS=43200
SESSION_REMEMBER_TTL_SECONDS=604800
# Optional for one development API; REQUIRED shared random secret in production.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# CSRF_SIGNING_KEY=
LOGIN_ACCOUNT_LIMIT=10
LOGIN_IP_LIMIT=1000
LOGIN_WINDOW_SECONDS=900
TRUST_PROXY_HOPS=0
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
JUDGE_QUEUE_PREFIX=assessment-dev
PUBLIC_TESTCASE_KMS_KEY_ID=replace-with-development-public-case-key-id
# Optional UTC start on FIRST seed; reruns preserve the existing schedule.
# DEV_ASSESSMENT_START_AT=2026-10-12T03:30:00Z
# Opt-in provisioning: DEV_STUDENT_ID, DEV_STUDENT_NAME, DEV_STUDENT_PASSWORD.
