NODE_ENV=development
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgresql://assessment_dev:replace-with-local-development-password@127.0.0.1:5432/assessment_dev?schema=public
DATABASE_POOL_MAX=20
# Optional Railway file materialization via scripts/production-runtime.mjs:
# DATABASE_TLS_CA_BASE64=<base64 of the PUBLIC PostgreSQL CA PEM; verify-full is enforced>
# Admin API only: QUESTION_KEYRING_BASE64=<base64 of the PRIVATE authoring keyring JSON>
# Never supply the authoring keyring or ADMIN_DATABASE_URL to the student API.
REDIS_QUEUE_URL=redis://127.0.0.1:6379/0
REDIS_SESSION_URL=redis://127.0.0.1:6379/1
APP_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://localhost:8081
ADMIN_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
# Separate administration database identity is REQUIRED in production; dev may use DATABASE_URL.
# ADMIN_DATABASE_URL=postgresql://assessment_admin_runtime:private-password@127.0.0.1:5432/assessment_dev
ADMIN_DATABASE_POOL_MAX=5
# Question authoring only: private keyring and actual pinned Linux toolchain catalog.
# QUESTION_KEYRING_FILE=/private/authoring/keyring.json
# SANDBOX_TOOLCHAIN_CATALOG=/private/authoring/catalog.json
SESSION_COOKIE_NAME=assessment_session_dev
SESSION_SECURE=false
SESSION_TTL_SECONDS=43200
SESSION_REMEMBER_TTL_SECONDS=604800
# Optional for one development API; REQUIRED shared random secret in production.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# CSRF_SIGNING_KEY=
LOGIN_ACCOUNT_LIMIT=10
LOGIN_IP_LIMIT=1000
LOGIN_WINDOW_SECONDS=900
TRUST_PROXY_HOPS=0
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
JUDGE_QUEUE_PREFIX=assessment-dev
# Enable only after the real judge release gate passes; worker heartbeats still gate availability.
EXECUTION_ENABLED=false
EXECUTION_MAX_PENDING_PUBLIC=1500
EXECUTION_MAX_PENDING_HIDDEN=1500
PUBLIC_TESTCASE_KMS_KEY_ID=replace-with-development-public-case-key-id
# Optional UTC start on FIRST seed; reruns preserve the existing schedule.
# DEV_ASSESSMENT_START_AT=2026-10-12T03:30:00Z
# First execution seed only: DEV_EXECUTION_START_AT (UTC ending in Z); reruns preserve its schedule.
# db:seed:judge requires TESTCASE_KEYRING_FILE and SANDBOX_TOOLCHAIN_CATALOG in the seed process.
# Opt-in provisioning: DEV_STUDENT_ID, DEV_STUDENT_NAME, DEV_STUDENT_PASSWORD.
# Opt-in dev:admin-user: DEV_ADMIN_EMAIL, DEV_ADMIN_NAME, DEV_ADMIN_PASSWORD (12+ characters).
