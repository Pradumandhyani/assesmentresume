# Runnable outbox/finalization process. No sandbox connection or testcase keys.
NODE_ENV=development
LOG_LEVEL=info
DATABASE_MAINTENANCE_URL=postgresql://assessment_maintenance:replace-with-development-password@127.0.0.1:5432/assessment_dev?schema=public
DATABASE_MAINTENANCE_POOL_MAX=4
REDIS_QUEUE_URL=redis://127.0.0.1:6379/0
JUDGE_QUEUE_PREFIX=assessment-dev
EXPIRY_RECONCILE_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=100
QUEUE_MAX_WAITING=5000
