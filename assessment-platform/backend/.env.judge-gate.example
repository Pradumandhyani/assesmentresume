# Merge these test-only settings into .env.judge.local ONLY on a dedicated disposable Linux node.
# The gate fails instead of skipping when prerequisites are absent. It uses ephemeral PostgreSQL.
JUDGE_GATE_ACK=DEDICATED_DISPOSABLE_LINUX
JUDGE_GATE_REDIS_URL=redis://127.0.0.1:6379/15
SANDBOX_RUNSC_PATH=/usr/local/bin/runsc
SANDBOX_RUNSC_SHA256=replace-with-reviewed-runsc-binary-sha256
# SANDBOX_BROKER_URL, CA/cert/key, toolchain catalog and keyring use .env.judge.example.
