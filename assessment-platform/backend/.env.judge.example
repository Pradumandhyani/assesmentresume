# Judge process only. Never place these identities or permissions in a browser/API deployment.
NODE_ENV=development
LOG_LEVEL=info
DATABASE_JUDGE_URL=postgresql://assessment_judge:replace-with-development-password@127.0.0.1:5432/assessment_dev?schema=public
DATABASE_JUDGE_POOL_MAX=4
REDIS_QUEUE_URL=redis://127.0.0.1:6379/0
JUDGE_QUEUE_PREFIX=assessment-dev
JUDGE_CONCURRENCY=4
SANDBOX_RUNTIME=gvisor
SANDBOX_BROKER_URL=https://replace-with-internal-mtls-broker.example.invalid
PUBLIC_TESTCASE_KMS_KEY_ID=replace-with-development-public-case-key-id
HIDDEN_TESTCASE_KMS_KEY_ID=replace-with-development-hidden-case-key-id
JUDGE_DIAGNOSTICS_KMS_KEY_ID=replace-with-development-diagnostics-key-id
# Provision mTLS and KMS credentials through workload identity, never source control.
