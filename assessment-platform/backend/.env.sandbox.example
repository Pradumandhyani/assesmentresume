# Dedicated Linux sandbox host only. No PostgreSQL, Redis or testcase keys here.
NODE_ENV=production
LOG_LEVEL=info
SANDBOX_BIND=127.0.0.1
SANDBOX_PORT=9443
SANDBOX_CONCURRENCY=8
SANDBOX_CA_FILE=/run/assessment-secrets/broker-ca.pem
SANDBOX_CERT_FILE=/run/assessment-secrets/broker-server.pem
SANDBOX_KEY_FILE=/run/assessment-secrets/broker-server-key.pem
# SHA-256 of each allowed client certificate DER, lowercase hex, comma separated.
SANDBOX_CLIENT_FINGERPRINTS=replace-with-reviewed-client-certificate-fingerprint
SANDBOX_TOOLCHAIN_CATALOG=/etc/assessment/toolchains.json
SANDBOX_RUNSC_PATH=/usr/local/bin/runsc
SANDBOX_RUNSC_SHA256=replace-with-reviewed-runsc-binary-sha256
