{
  "name": "@assessment/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test prisma prisma.config.ts --max-warnings=0",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:format": "prisma format",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "dev:student": "tsx prisma/provision-student.ts",
    "db:seed:judge": "tsx prisma/seed-judge.ts",
    "worker:judge": "node --env-file=.env.judge.local dist/workers/judge/main.js",
    "worker:maintenance": "node --env-file=.env.maintenance.local dist/workers/outbox/main.js",
    "sandbox:broker": "node --env-file=.env.sandbox.local dist/workers/sandbox/broker.js",
    "sandbox:reap": "node --env-file=.env.sandbox.local dist/workers/sandbox/reaper.js",
    "test:judge": "node --env-file=.env.judge.local --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --config jest.judge.config.cjs",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand test/student.integration.spec.ts test/attempts.integration.spec.ts test/execution.integration.spec.ts test/admin.integration.spec.ts test/heartbeat.integration.spec.ts",
    "dev:admin-user": "tsx prisma/provision-admin.ts"
  },
  "dependencies": {
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "bcryptjs": "3.0.3",
    "bullmq": "5.81.5",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "nestjs-pino": "4.6.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.7",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/pg": "8.23.1",
    "jest": "29.7.0",
    "prisma": "7.10.0",
    "ts-jest": "29.4.14",
    "tsx": "4.23.15"
  }
}
