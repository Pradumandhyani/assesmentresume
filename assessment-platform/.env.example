# Development infrastructure only. Choose your own local password before starting Docker.
POSTGRES_DB=assessment_dev
POSTGRES_USER=assessment_dev
POSTGRES_PASSWORD=replace-with-local-development-password
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://assessment_dev:replace-with-local-development-password@127.0.0.1:5432/assessment_dev?schema=public
